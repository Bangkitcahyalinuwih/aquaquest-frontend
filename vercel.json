{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://aquaquest-backend.hostless.app/api/:path*" },
    {
      "source": "/storage/:path*",
      "destination": "https://aquaquest-backend.hostless.app/storage/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
